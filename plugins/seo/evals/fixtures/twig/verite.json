{
  "langue": "en",
  "pays": "GB",
  "rendu_local": "aucun",
  "defauts": [
    {
      "controle": "T-TITLE-DOUBLON",
      "fichier_source": "templates/base.html.twig",
      "detection": "modele",
      "verif_apres": {
        "type": "motif",
        "fichier": "templates/home.html.twig",
        "present": "\\bblock\\s+title\\b",
        "echantillon_ok": "{% block title %}Physiotherapy in London{% endblock %}",
        "echantillon_ko": "{% extends 'base.html.twig' %}\n{% block content %}<h1>Example Physio Clinic</h1>{% endblock %}"
      }
    },
    {
      "controle": "T-TITLE-DOUBLON",
      "fichier_source": "templates/base.html.twig",
      "detection": "modele",
      "verif_apres": {
        "type": "motif",
        "fichier": "templates/treatments.html.twig",
        "present": "\\bblock\\s+title\\b",
        "echantillon_ok": "{% block title %}Physiotherapy treatments{% endblock %}",
        "echantillon_ko": "{% extends 'base.html.twig' %}\n{% block content %}<h1>Physiotherapy treatments</h1>{% endblock %}"
      }
    },
    {
      "controle": "T-TITLE-DOUBLON",
      "fichier_source": "templates/base.html.twig",
      "detection": "modele",
      "verif_apres": {
        "type": "motif",
        "fichier": "templates/contact.html.twig",
        "present": "\\bblock\\s+title\\b",
        "echantillon_ok": "{% block title %}Contact the clinic{% endblock %}",
        "echantillon_ko": "{% extends 'base.html.twig' %}\n{% block content %}<h1>Contact the clinic</h1>{% endblock %}"
      }
    },
    {
      "controle": "T-DESC-ABSENT",
      "fichier_source": "templates/base.html.twig",
      "detection": "modele",
      "verif_apres": {
        "type": "motif",
        "fichier": "templates/base.html.twig",
        "present": "name=[\"']description",
        "echantillon_ok": "<meta name=\"description\" content=\"{% block description %}{% endblock %}\">",
        "echantillon_ko": "<title>{% block title %}Physio{% endblock %}</title>"
      }
    },
    {
      "controle": "T-OG-ABSENT",
      "fichier_source": "templates/base.html.twig",
      "detection": "modele",
      "verif_apres": {
        "type": "motif",
        "fichier": "templates/base.html.twig",
        "present": "og:title",
        "echantillon_ok": "<meta property=\"og:title\" content=\"{{ block('title') }}\">",
        "echantillon_ko": "<title>{% block title %}Physio{% endblock %}</title>"
      }
    }
  ]
}
